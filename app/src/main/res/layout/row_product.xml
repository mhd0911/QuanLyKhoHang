<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/row_name"
            style="@style/WarehouseLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/row_quantity"
            style="@style/WarehouseLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/row_category"
        style="@style/WarehouseChip"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/row_warning"
        style="@style/WarehouseChip"
        android:layout_marginTop="5dp"
        android:background="@drawable/chip_warning"
        android:text="@string/low_stock"
        android:textColor="@color/danger"
        android:visibility="gone" />
</LinearLayout>
